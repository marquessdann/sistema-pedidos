# ---------------------------------------------------------------
# Sistema de Pedidos Della — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o arquivo .env.
# ---------------------------------------------------------------

# Ambiente: development | production | test
NODE_ENV=development

# Banco de dados PostgreSQL
# DATABASE_URL: conexão usada pela aplicação (na nuvem, a URL com "pooler")
# DIRECT_URL: conexão direta usada pelas migrações (localmente pode ser igual à DATABASE_URL)
# No Vercel com Neon/Supabase essas variáveis são preenchidas pela integração (veja docs/DEPLOY-VERCEL.md)
DATABASE_URL=postgresql://della:della@localhost:5432/della?schema=public
DIRECT_URL=postgresql://della:della@localhost:5432/della?schema=public
# Banco usado somente pelos testes automatizados (será APAGADO a cada execução)
TEST_DATABASE_URL=postgresql://della:della@localhost:5432/della_test?schema=public

# Servidor HTTP da API
PORT=3333
HOST=0.0.0.0
# URL pública do sistema (usada em links). Em produção use HTTPS.
APP_URL=http://localhost:5173
# Em produção, defina como true (exige HTTPS) para cookies seguros
COOKIE_SECURE=false
# Duração da sessão em horas
SESSION_TTL_HOURS=12

# Primeiro administrador (usado por "npm run db:seed" ou "npm run create-admin")
ADMIN_USERNAME=daniel
ADMIN_NAME=Daniel
# Mínimo de 10 caracteres com letras e números. Troque antes de implantar!
ADMIN_PASSWORD=

# Senha do representante Victor Badur (usuário "victor"), criada pelo seed.
# Mínimo de 10 caracteres com letras e números. Sem ela, em desenvolvimento usa 1234 com troca obrigatória.
SEED_VICTOR_PASSWORD=

# E-mail (opcional). Sem SMTP_HOST, o envio por e-mail fica desabilitado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Della <comercial@exemplo.com.br>"

# WhatsApp Business Platform (opcional, integração futura — não configurado)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
